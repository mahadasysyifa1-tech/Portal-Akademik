rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Core authentication and validation primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'mahadasysyifa1@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isAcademicMember() {
      return isAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/academic_members/$(request.auth.uid))
      );
    }

    function isIdentityOwner(identityKey) {
      return isVerifiedUser() &&
        exists(/databases/$(database)/documents/directory_identities/$(identityKey)) &&
        get(/databases/$(database)/documents/directory_identities/$(identityKey)).data.ownerEmail == request.auth.token.email;
    }

    function isValidAdminUser(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
        data.uid is string && data.uid == uid && isValidId(data.uid) &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
        data.createdAt == request.time;
    }

    function isValidAcademicMember(data, uid) {
      return data.keys().hasAll(['uid', 'role', 'email', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'role', 'email', 'updatedAt']) &&
        data.uid is string && data.uid == uid && isValidId(data.uid) &&
        data.role in ['admin', 'teacher', 'student'] &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
        data.updatedAt == request.time;
    }

    function isValidDirectoryIdentity(data) {
      return data.keys().hasAll(['entityType', 'entityId', 'ownerEmail', 'updatedByUid', 'updatedAt']) &&
        data.keys().hasOnly(['entityType', 'entityId', 'ownerEmail', 'updatedByUid', 'updatedAt']) &&
        data.entityType in ['teacher', 'student'] &&
        isValidId(data.entityId) &&
        data.ownerEmail is string && data.ownerEmail.size() > 0 && data.ownerEmail.size() <= 200 &&
        data.updatedByUid is string && data.updatedByUid == request.auth.uid && isValidId(data.updatedByUid) &&
        data.updatedAt == request.time;
    }

    function isValidPublicMedia(data) {
      return data.keys().hasAll(['entityType', 'entityId', 'imageUrl', 'sourceType', 'visibility', 'updatedByUid', 'updatedAt']) &&
        data.keys().hasOnly(['entityType', 'entityId', 'imageUrl', 'storagePath', 'sourceType', 'visibility', 'updatedByUid', 'updatedAt']) &&
        data.entityType in ['subject', 'book', 'class', 'teacher'] &&
        isValidId(data.entityId) &&
        data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 350000 &&
        (!('storagePath' in data) || (data.storagePath is string && data.storagePath.size() <= 512)) &&
        data.sourceType in ['upload', 'url'] &&
        data.visibility == 'public' &&
        data.updatedByUid is string && data.updatedByUid == request.auth.uid && isValidId(data.updatedByUid) &&
        data.updatedAt == request.time;
    }

    function isValidStudentMedia(data) {
      return data.keys().hasAll(['entityType', 'entityId', 'imageUrl', 'sourceType', 'visibility', 'updatedByUid', 'updatedAt']) &&
        data.keys().hasOnly(['entityType', 'entityId', 'imageUrl', 'storagePath', 'sourceType', 'visibility', 'updatedByUid', 'updatedAt']) &&
        data.entityType == 'student' &&
        isValidId(data.entityId) &&
        data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 350000 &&
        (!('storagePath' in data) || (data.storagePath is string && data.storagePath.size() <= 512)) &&
        data.sourceType in ['upload', 'url'] &&
        data.visibility == 'academic' &&
        data.updatedByUid is string && data.updatedByUid == request.auth.uid && isValidId(data.updatedByUid) &&
        data.updatedAt == request.time;
    }

    // Bootstrapped and delegated admins
    match /admins/{uid} {
      allow get: if isVerifiedUser() && isValidId(uid) && (uid == request.auth.uid || isAdmin());
      allow list: if false;
      allow create: if isAdmin() && isValidId(uid) && isValidAdminUser(incoming(), uid);
      allow update: if isAdmin() && isValidId(uid) && isValidAdminUser(incoming(), uid);
      allow delete: if isAdmin() && isValidId(uid);
    }

    // Verified academic members allowed to view student portraits
    match /academic_members/{uid} {
      allow get: if isVerifiedUser() && isValidId(uid) && (uid == request.auth.uid || isAdmin());
      allow list: if false;
      allow create, update: if isAdmin() && isValidId(uid) && isValidAcademicMember(incoming(), uid);
      allow delete: if isAdmin() && isValidId(uid);
    }

    // Admin-managed ownership bindings for teacher/student self-edit
    match /directory_identities/{identityId} {
      allow get: if isVerifiedUser() && isValidId(identityId) && (
        isAdmin() ||
        resource.data.ownerEmail == request.auth.token.email
      );
      allow list: if false;
      allow create: if isAdmin() &&
        isValidId(identityId) &&
        isValidDirectoryIdentity(incoming()) &&
        identityId == (incoming().entityType + '__' + incoming().entityId);
      allow update: if isAdmin() &&
        isValidId(identityId) &&
        isValidDirectoryIdentity(incoming()) &&
        incoming().entityType == existing().entityType &&
        incoming().entityId == existing().entityId;
      allow delete: if isAdmin() && isValidId(identityId);
    }

    // Public academic directory media: subjects, books, classes, teachers
    match /directory_media/{mediaId} {
      allow get: if isSignedIn() && isValidId(mediaId) && resource.data.visibility == 'public';
      allow list: if isSignedIn() && resource.data.visibility == 'public';
      allow create: if isVerifiedUser() &&
        isValidId(mediaId) &&
        isValidPublicMedia(incoming()) &&
        mediaId == (incoming().entityType + '__' + incoming().entityId) && (
          isAdmin() ||
          (incoming().entityType == 'teacher' && isIdentityOwner('teacher__' + incoming().entityId))
        );
      allow update: if isVerifiedUser() &&
        isValidId(mediaId) &&
        isValidPublicMedia(incoming()) &&
        incoming().entityType == existing().entityType &&
        incoming().entityId == existing().entityId &&
        incoming().visibility == existing().visibility && (
          isAdmin() ||
          (existing().entityType == 'teacher' && isIdentityOwner('teacher__' + existing().entityId))
        );
      allow delete: if isVerifiedUser() &&
        isValidId(mediaId) && (
          isAdmin() ||
          (existing().entityType == 'teacher' && isIdentityOwner('teacher__' + existing().entityId))
        );
    }

    // Protected student directory portraits: strictly isolated from guest reads
    match /directory_media_students/{studentId} {
      allow get: if isVerifiedUser() &&
        isValidId(studentId) && (
          isAdmin() ||
          isAcademicMember() ||
          isIdentityOwner('student__' + studentId)
        );
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(studentId) &&
        isValidStudentMedia(incoming()) &&
        incoming().entityId == studentId && (
          isAdmin() ||
          isIdentityOwner('student__' + studentId)
        );
      allow update: if isVerifiedUser() &&
        isValidId(studentId) &&
        isValidStudentMedia(incoming()) &&
        incoming().entityType == existing().entityType &&
        incoming().entityId == existing().entityId &&
        incoming().visibility == existing().visibility && (
          isAdmin() ||
          isIdentityOwner('student__' + studentId)
        );
      allow delete: if isVerifiedUser() &&
        isValidId(studentId) && (
          isAdmin() ||
          isIdentityOwner('student__' + studentId)
        );
    }
  }
}
